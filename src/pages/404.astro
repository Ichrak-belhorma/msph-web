---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config/site';
import { routes } from '../i18n/routes';
---

<BaseLayout lang="fr" title="Page introuvable | MSPH" description="La page demandée n’existe pas ou a été déplacée." alternates={routes.home} noindex>
  <section class="section nf">
    <div class="container container--narrow nf__inner">
      <p class="nf__code">404</p>
      <h1>Cette page s’est fait la malle…</h1>
      <p class="lead">La page que vous cherchez n’existe pas ou a été déplacée. <span lang="en">This page could not be found.</span></p>
      <div class="btn-row nf__actions">
        <a href="/" class="btn btn--primary btn--lg"><Icon name="House" />Accueil</a>
        <a href="/devis-gratuit/" class="btn btn--cta btn--lg">Diagnostic gratuit</a>
        <a href={`tel:${site.contact.phoneIntl}`} class="btn btn--outline btn--lg"><Icon name="Phone" />{site.contact.phone}</a>
      </div>
      <p class="nf__en"><a href="/en/">English version →</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .nf__inner {
    text-align: center;
  }
  .nf__code {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(5rem, 3rem + 10vw, 9rem);
    line-height: 1;
    background: linear-gradient(120deg, var(--blue-700), var(--green-500));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .nf__actions {
    justify-content: center;
    margin-top: 2rem;
  }
  .nf__en {
    margin-top: 1.5rem;
  }
</style>
