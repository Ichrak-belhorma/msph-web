---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import { site } from '../config/site';
import { locales, type Lang } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Chemins équivalents dans chaque langue (pour hreflang et le sélecteur de langue). */
  alternates: Record<Lang, string>;
  image?: string;
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  /** Masque la barre d'actions mobile et le bandeau d'appel du pied de page (page de devis). */
  hideMobileBar?: boolean;
}

const { lang, title, description, alternates, image = '/og-image.jpg', schema = [], noindex = false, hideMobileBar = false } = Astro.props;
const ui = t(lang);
const siteUrl = Astro.site ?? new URL(site.url);
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = new URL(image, siteUrl).href;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${siteUrl.origin}/#organization`,
  name: `${site.name} — ${site.brand}`,
  legalName: site.legalName,
  url: siteUrl.origin,
  logo: new URL('/brand/msph-logo.svg', siteUrl).href,
  image: ogImage,
  telephone: site.contact.phoneIntl,
  email: site.contact.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    postalCode: site.address.postalCode,
    addressLocality: site.address.city,
    addressCountry: 'FR',
  },
  ...(site.address.geo ? { geo: { '@type': 'GeoCoordinates', latitude: site.address.geo.lat, longitude: site.address.geo.lng } } : {}),
  areaServed: site.serviceAreas,
  priceRange: '€€',
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '08:00', closes: '19:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '09:00', closes: '17:00' },
  ],
  sameAs: Object.values(site.social).filter(Boolean),
};
const jsonLd = [organization, ...schema];
---

<!doctype html>
<html lang={lang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="alternate" hreflang="fr-FR" href={new URL(alternates.fr, siteUrl).href} />
    <link rel="alternate" hreflang="en" href={new URL(alternates.en, siteUrl).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(alternates.fr, siteUrl).href} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${site.name} — ${site.brand}`} />
    <meta property="og:locale" content={locales[lang].replace('-', '_')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#0a2a5a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://images.pexels.com" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js');
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#contenu">{ui.skip}</a>
    <Header lang={lang} alternates={alternates} />
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} alternates={alternates} showCta={!hideMobileBar} />
    {!hideMobileBar && <MobileBar lang={lang} />}

    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
