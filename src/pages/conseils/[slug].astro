---
import ArticleView from '../../views/ArticleView.astro';
import { articles } from '../../data/articles';

export function getStaticPaths() {
  return articles.map((article) => ({ params: { slug: article.fr.slug }, props: { article } }));
}

const { article } = Astro.props;
---

<ArticleView lang="fr" article={article} />
