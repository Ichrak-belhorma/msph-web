---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import LangSwitch from './LangSwitch.astro';
import CertLogos from './CertLogos.astro';
import { site } from '../config/site';
import { services } from '../data/services';
import { path, type Lang } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
  alternates: Record<Lang, string>;
  showCta?: boolean;
}

const { lang, alternates, showCta = true } = Astro.props;
const ui = t(lang);
const year = new Date().getFullYear();

const companyLinks = [
  { href: path('business', lang), label: ui.nav.businessContracts },
  { href: path('sectors', lang), label: ui.nav.sectors },
  { href: path('residential', lang), label: ui.nav.residential },
  { href: path('about', lang), label: ui.nav.aboutUs },
  { href: path('certifications', lang), label: ui.nav.certifications },
  { href: path('careers', lang), label: ui.nav.careers },
  { href: path('blog', lang), label: ui.nav.blog },
  { href: path('faq', lang), label: ui.nav.faq },
];

const socials = [
  { href: site.social.linkedin, label: 'LinkedIn', d: 'M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z' },
  { href: site.social.facebook, label: 'Facebook', d: 'M24 12.07C24 5.41 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.04V9.41c0-3.02 1.8-4.7 4.54-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.5c-1.5 0-1.96.93-1.96 1.89v2.26h3.32l-.53 3.5h-2.8V24C19.62 23.1 24 18.1 24 12.07z' },
  { href: site.social.instagram, label: 'Instagram', d: 'M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.72 3.72 0 0 1-1.38-.9 3.72 3.72 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16M12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63a5.88 5.88 0 0 0-2.13 1.38A5.88 5.88 0 0 0 .63 4.14C.33 4.9.13 5.78.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.3.79.72 1.46 1.38 2.13a5.88 5.88 0 0 0 2.13 1.38c.76.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56a5.88 5.88 0 0 0 2.13-1.38 5.88 5.88 0 0 0 1.38-2.13c.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91a5.88 5.88 0 0 0-1.38-2.13A5.88 5.88 0 0 0 19.86.63C19.1.33 18.22.13 16.95.07 15.67.01 15.26 0 12 0zm0 5.84a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.4-11.85a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88z' },
].filter((s) => s.href);
---

<footer class="footer">
  {
    showCta && (
  <div class="footer__cta">
    <div class="container footer__cta-inner">
      <div>
        <p class="footer__cta-title">{lang === 'fr' ? 'Un problème de nuisibles ? Parlons-en maintenant.' : 'A pest problem? Let’s talk now.'}</p>
        <p class="footer__cta-text">{lang === 'fr' ? 'Diagnostic gratuit, devis détaillé sous 24 h, intervention rapide.' : 'Free assessment, detailed quote within 24 h, fast response.'}</p>
      </div>
      <div class="btn-row">
        <a href={`tel:${site.contact.phoneIntl}`} class="btn btn--ghost-light btn--lg"><Icon name="Phone" />{site.contact.phone}</a>
        <a href={path('quote', lang)} class="btn btn--cta btn--lg">{ui.cta.quoteLong}</a>
      </div>
    </div>
  </div>
    )
  }

  <div class="container footer__main">
    <div class="footer__brand">
      <Logo variant="light" tagline={lang === 'fr' ? 'Lutte antiparasitaire & hygiène' : 'Pest control & hygiene'} />
      <p>{ui.footer.pitch}</p>
      <p class="footer__label">{ui.footer.certifiedBy}</p>
      <CertLogos compact />
    </div>

    <div class="footer__col">
      <p class="footer__title">{ui.footer.services}</p>
      <ul role="list">
        {services.map((s) => <li><a href={path(s.key, lang)}>{s[lang].menuLabel}</a></li>)}
        <li><a href={path('services', lang)}>{ui.nav.allServices}</a></li>
      </ul>
    </div>

    <div class="footer__col">
      <p class="footer__title">{ui.footer.company}</p>
      <ul role="list">
        {companyLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>

    <div class="footer__col footer__contact">
      <p class="footer__title">{ui.footer.contact}</p>
      <ul role="list">
        <li><Icon name="Phone" size={18} /><a href={`tel:${site.contact.phoneIntl}`}>{site.contact.phone}</a></li>
        <li><Icon name="Mail" size={18} /><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></li>
        <li>
          <Icon name="MapPin" size={18} />
          <span>{site.address.street}<br />{site.address.postalCode} {site.address.city}</span>
        </li>
      </ul>
      <p class="footer__title footer__title--sm">{ui.footer.hours}</p>
      <dl class="footer__hours">
        {
          site.hours[lang].map((h) => (
            <div>
              <dt>{h.days}</dt>
              <dd>{h.time}</dd>
            </div>
          ))
        }
      </dl>
      {
        socials.length > 0 && (
          <ul class="footer__socials" role="list">
            {socials.map((s) => (
              <li>
                <a href={s.href} aria-label={s.label} rel="noopener" target="_blank">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                    <path d={s.d} />
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>

  <div class="footer__bottom">
    <div class="container footer__bottom-inner">
      <p>© {year} {site.legalName} — {site.brand}. {ui.footer.rights}</p>
      <ul role="list">
        <li><a href={path('legal', lang)}>{ui.footer.legal}</a></li>
        <li><a href={path('privacy', lang)}>{ui.footer.privacy}</a></li>
        <li><a href="/sitemap-index.xml">{ui.footer.sitemap}</a></li>
      </ul>
      <LangSwitch lang={lang} alternates={alternates} variant="dark" />
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--navy-950);
    color: #a9b8ce;
    font-size: var(--fs-sm);
  }
  .footer a {
    color: #d6e0ee;
    text-decoration: none;
  }
  .footer a:hover {
    color: #fff;
    text-decoration: underline;
  }

  .footer__cta {
    background:
      radial-gradient(circle at 85% 0%, rgb(52 196 122 / 0.22), transparent 40%),
      linear-gradient(120deg, var(--navy-800), var(--blue-700));
  }
  .footer__cta-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: clamp(2rem, 1.5rem + 2vw, 3rem);
  }
  .footer__cta-title {
    margin: 0 0 0.35rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--fs-2xl);
    line-height: 1.2;
    color: #fff;
  }
  .footer__cta-text {
    margin: 0;
    color: #c9d6e8;
    font-size: var(--fs-base);
  }
  .footer__cta .btn:hover {
    text-decoration: none;
  }

  .footer__main {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem 1.5rem;
    padding-block: clamp(3rem, 2.5rem + 2vw, 4.5rem);
  }
  .footer__brand,
  .footer__contact {
    grid-column: 1 / -1;
  }
  @media (min-width: 700px) {
    .footer__brand,
    .footer__contact {
      grid-column: auto;
    }
  }
  @media (min-width: 1100px) {
    .footer__main {
      grid-template-columns: 1.5fr 1fr 1fr 1.25fr;
    }
  }
  .footer__brand p {
    margin: 1.25rem 0 0;
    max-width: 380px;
    line-height: 1.7;
  }
  .footer__brand .footer__label {
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #7f93b0;
  }
  .footer__title {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    color: #fff;
  }
  .footer__title--sm {
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }
  .footer__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .footer__contact li {
    display: flex;
    gap: 0.65rem;
    align-items: flex-start;
  }
  .footer__contact li :global(svg) {
    margin-top: 3px;
    color: var(--green-400);
    flex: none;
  }
  .footer__hours {
    margin: 0;
    display: grid;
    gap: 0.25rem;
  }
  .footer__hours div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    max-width: 320px;
  }
  .footer__hours dd {
    margin: 0;
    color: #d6e0ee;
  }
  .footer__socials {
    display: flex !important;
    gap: 0.5rem !important;
    margin-top: 1.25rem !important;
  }
  .footer__socials a {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.08);
  }
  .footer__socials a:hover {
    background: var(--green-600);
  }

  .footer__bottom {
    border-top: 1px solid rgb(255 255 255 / 0.08);
  }
  .footer__bottom-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.25rem;
    font-size: var(--fs-xs);
  }
  .footer__bottom p {
    margin: 0;
  }
  .footer__bottom ul {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
