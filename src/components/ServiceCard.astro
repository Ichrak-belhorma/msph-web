---
import Icon from './Icon.astro';
import Img from './Img.astro';
import type { Service } from '../data/services';
import { path, type Lang } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props {
  service: Service;
  lang: Lang;
}

const { service, lang } = Astro.props;
const c = service[lang];
---

<article class="svc-card" data-reveal>
  <a href={path(service.key, lang)} class="svc-card__link">
    <div class="svc-card__media">
      <div class="svc-card__img media">
        <Img name={service.image} lang={lang} sizes="(min-width: 1100px) 380px, (min-width: 700px) 45vw, 100vw" width={800} />
      </div>
      <span class="svc-card__icon"><Icon name={service.icon} size={26} /></span>
    </div>
    <div class="svc-card__body">
      <h3>{c.title}</h3>
      <p>{c.short}</p>
      <span class="link-arrow">{t(lang).cta.learnMore}<Icon name="ArrowRight" /></span>
    </div>
  </a>
</article>

<style>
  .svc-card {
    height: 100%;
  }
  .svc-card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    box-shadow: var(--shadow-sm);
    transition:
      transform 0.3s var(--ease),
      box-shadow 0.3s var(--ease),
      border-color 0.3s;
  }
  .svc-card__link:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--blue-100);
    color: inherit;
  }
  .svc-card__media {
    position: relative;
  }
  .svc-card__img {
    aspect-ratio: 16 / 10;
    border-radius: 0;
  }
  @media (max-width: 599px) {
    .svc-card__img {
      aspect-ratio: 2.4 / 1;
    }
    .svc-card__body {
      padding: 2.1rem 1.25rem 1.25rem;
    }
  }
  .svc-card__media :global(img) {
    transition: transform 0.6s var(--ease);
  }
  .svc-card__link:hover .svc-card__media :global(img) {
    transform: scale(1.05);
  }
  .svc-card__icon {
    position: absolute;
    left: 1.25rem;
    bottom: -26px;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 16px;
    background: var(--blue-700);
    color: #fff;
    box-shadow: 0 10px 20px -8px rgb(13 69 136 / 0.6);
    z-index: 2;
  }
  .svc-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 2.3rem 1.5rem 1.5rem;
  }
  .svc-card__body h3 {
    margin-bottom: 0.4rem;
  }
  .svc-card__body p {
    color: var(--ink-600);
    font-size: var(--fs-sm);
    flex: 1;
  }
</style>
