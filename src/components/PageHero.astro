---
import Breadcrumbs from './Breadcrumbs.astro';
import Img from './Img.astro';
import type { ImageKey } from '../data/images';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
  eyebrow?: string;
  title: string;
  lead?: string;
  crumbs: { label: string; href?: string }[];
  image?: ImageKey;
  /** Mise en page avec un panneau (formulaire, carte) à droite. */
  withAside?: boolean;
}

const { lang, eyebrow, title, lead, crumbs, image, withAside = false } = Astro.props;
---

<section class:list={['page-hero', 'on-dark', { 'page-hero--aside': withAside }]}>
  {
    image && (
      <div class="page-hero__bg" aria-hidden="true">
        <Img name={image} lang={lang} sizes="100vw" width={1600} eager alt="" />
      </div>
    )
  }
  <div class="container page-hero__inner">
    <div class="page-hero__content">
      <Breadcrumbs lang={lang} items={crumbs} />
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      {lead && <p class="page-hero__lead">{lead}</p>}
      <slot />
    </div>
    {
      withAside && (
        <div class="page-hero__aside">
          <slot name="aside" />
        </div>
      )
    }
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background:
      radial-gradient(circle at 90% 10%, rgb(52 196 122 / 0.16), transparent 35%),
      linear-gradient(120deg, var(--navy-900) 0%, var(--navy-800) 55%, var(--blue-700) 100%);
    color: #c9d6e8;
  }
  .page-hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .page-hero__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.22;
    mix-blend-mode: luminosity;
  }
  .page-hero__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--navy-900) 15%, rgb(7 28 61 / 0.6) 70%, rgb(7 28 61 / 0.35));
  }
  .page-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    padding-block: clamp(2.5rem, 2rem + 3vw, 5rem) clamp(3rem, 2.5rem + 3vw, 5.5rem);
  }
  .page-hero--aside .page-hero__inner {
    align-items: start;
  }
  @media (min-width: 1000px) {
    .page-hero--aside .page-hero__inner {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 4rem;
    }
  }
  .page-hero__inner > * {
    min-width: 0;
  }
  .page-hero__content {
    max-width: 780px;
  }
  .page-hero h1 {
    color: #fff;
    font-size: var(--fs-4xl);
  }
  .page-hero__lead {
    font-size: var(--fs-lg);
    color: #c9d6e8;
    max-width: 680px;
  }
</style>
