<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    line-height: 1;
    color: var(--blue-700);
  }
  .logo__emblem {
    width: 64px;
    height: auto;
    flex: none;
    fill: currentColor;
  }
  .logo__text {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding-left: 0.75rem;
    border-left: 2px solid var(--blue-100);
  }
  .logo__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--navy-900);
    white-space: nowrap;
  }
  .logo__tagline {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-500);
    white-space: nowrap;
  }
  .logo--light {
    color: #fff;
  }
  .logo--light .logo__name {
    color: #fff;
  }
  .logo--light .logo__tagline {
    color: #9fb3cf;
  }
  .logo--light .logo__text {
    border-left-color: rgb(255 255 255 / 0.2);
  }
</style>
