---
import Icon from './Icon.astro';
import { testimonials } from '../data/testimonials';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<div class="grid grid--3">
  {
    testimonials.map((item, i) => (
      <figure class="quote" data-reveal style={`transition-delay:${i * 80}ms`}>
        <div class="quote__stars" role="img" aria-label={`${item.rating}/5`}>
          {Array.from({ length: item.rating }).map(() => (
            <Icon name="Star" size={18} />
          ))}
        </div>
        <blockquote>
          <p>{lang === 'fr' ? `« ${item[lang]} »` : `“${item[lang]}”`}</p>
        </blockquote>
        <figcaption>
          <span class="quote__avatar" aria-hidden="true">
            <Icon name="Quote" size={18} />
          </span>
          <span>
            <strong>{item.author}</strong>
            <small>{item.org[lang]}</small>
          </span>
        </figcaption>
      </figure>
    ))
  }
</div>

<style>
  .quote {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 1.75rem;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }
  .quote__stars {
    display: flex;
    gap: 2px;
    color: var(--amber-500);
    margin-bottom: 1rem;
  }
  .quote__stars :global(svg) {
    fill: currentColor;
  }
  .quote blockquote {
    margin: 0 0 1.5rem;
    flex: 1;
  }
  .quote blockquote p {
    margin: 0;
    font-size: 1.02rem;
    color: var(--ink-700);
  }
  .quote figcaption {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }
  .quote__avatar {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--blue-50);
    color: var(--blue-700);
  }
  .quote strong {
    display: block;
    font-family: var(--font-display);
    color: var(--navy-900);
  }
  .quote small {
    color: var(--ink-500);
  }
</style>
