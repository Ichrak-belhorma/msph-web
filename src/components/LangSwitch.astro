---
import { languages, type Lang } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
  alternates: Record<Lang, string>;
  variant?: 'light' | 'dark';
}

const { lang, alternates, variant = 'light' } = Astro.props;
const ui = t(lang);
const codes = Object.keys(languages) as Lang[];
---

<nav class:list={['lang-switch', `lang-switch--${variant}`]} aria-label={ui.nav.language}>
  {
    codes.map((code) =>
      code === lang ? (
        <span class="lang-switch__item is-current" aria-current="true" lang={code} title={languages[code]}>
          {code.toUpperCase()}
        </span>
      ) : (
        <a class="lang-switch__item" href={alternates[code]} hreflang={code} lang={code} title={languages[code]}>
          {code.toUpperCase()}
        </a>
      ),
    )
  }
</nav>

<style>
  .lang-switch {
    display: inline-flex;
    padding: 3px;
    gap: 2px;
    border-radius: var(--radius-pill);
    background: var(--ink-100);
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 700;
    width: fit-content;
  }
  .lang-switch__item {
    display: inline-grid;
    place-items: center;
    min-width: 38px;
    min-height: 28px;
    padding: 0 0.5rem;
    border-radius: var(--radius-pill);
    color: var(--ink-600);
    text-decoration: none;
  }
  a.lang-switch__item:hover {
    color: var(--blue-700);
    background: #fff;
  }
  .is-current {
    background: var(--blue-700);
    color: #fff;
  }
  .lang-switch--dark {
    background: rgb(255 255 255 / 0.08);
  }
  .lang-switch--dark .lang-switch__item {
    color: #c9d6e8;
    min-height: 24px;
  }
  .lang-switch--dark a.lang-switch__item:hover {
    background: rgb(255 255 255 / 0.12);
    color: #fff;
  }
  .lang-switch--dark .is-current {
    background: var(--green-600);
    color: #fff;
  }
</style>
